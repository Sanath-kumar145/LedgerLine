# ==============================================================================
# LedgerLine API — Environment Variable Template (.env.example)
# Copy this file to .env or export these variables in your terminal shell.
# NOTE: Spring Boot does NOT auto-load .env files by default.
# In PowerShell: $env:DB_USERNAME="root"; $env:DB_PASSWORD="your_password"
# In Bash: export DB_USERNAME="root"; export DB_PASSWORD="your_password"
# ==============================================================================

# Application Profile: 'dev' for local developer machines, 'prod' for production/cloud
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
# Local development default: root with empty password on localhost:3306
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ledgerline
DB_USERNAME=root
DB_PASSWORD=

# Full JDBC URL (optional, defaults constructed from DB_HOST/DB_PORT/DB_NAME)
# For local dev without TLS:
# DB_URL=jdbc:mysql://localhost:3306/ledgerline?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# For production cloud with TLS:
# DB_URL=jdbc:mysql://<host>:3306/ledgerline?sslMode=REQUIRED&serverTimezone=UTC

# JWT Signing Secret (must have at least 32 bytes / 256 bits of entropy)
# In dev profile, defaults to a safe built-in 256-bit local key.
# In production, MUST be generated via: openssl rand -hex 32
JWT_SECRET=your_32_byte_hex_or_base64_jwt_secret_key_here!

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Server Port
PORT=8080

